+                r = client.post("/act", json={"observation": obs.to_dict(),
+                                              "hand_results": pending})
+                pending = []
+                assert r.status_code == 200, r.json()
+                assert r.json()["hand_end_errors"] == []
+                a = Action[r.json()["action"]]

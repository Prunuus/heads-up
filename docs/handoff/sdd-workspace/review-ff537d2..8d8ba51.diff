+"""
+agent.py - YOUR poker bot. This one file is a complete web server.
+
+Run it:
+    python agent.py                  # listens on port 5008
+    PORT=5010 python agent.py        # or pick a port
+
+Play a match against a baseline (three windows):
+    python agent.py                                 # your bot on port 5008
+    python baseline-bots/baseline_random.py         # opponent on port 5009
+    python judge_engine.py                          # judge: both halves (uses those two ports)
+
+Check that the tournament can run it:
+    python -m pytest -q              # tests in test_agent.py
+    ./tools/check_build.sh           # builds and smoke-tests it like the tournament
+
+TODO:
+    1. Assign your agent a unique PARTICIPANT and AGENT_NAME below.
+    2. Implement the three functions between "YOUR CODE HERE" and "END OF YOUR CODE".
+
+Everything under "SERVER PLUMBING" talks to the judge. You normally never
+need to change it, and if you break it the judge can't talk to your bot.
+"""
+
+import os
+import traceback
+
+import uvicorn
+from fastapi import FastAPI, Request
+from fastapi.responses import JSONResponse
+
+from evaluator import card_rank, card_suit, cards_to_str, omaha_score, warmup  # handy helpers, see evaluator.py
+from game import Action, AgentConfig, HandResult, Observation, Street
+
+# Build omaha_score's lookup table now, while the server starts, instead of
+# during your first decision (where it would eat into your time bank).
+# Do any other slow setup (loading a model, ...) here too: the server must
+# answer within 15 seconds of starting.
+warmup()
+
+
+# rename as your team/bot's name
+PARTICIPANT = "SharkTank"
+AGENT_NAME = "SharkTankExploiter"
+
+
+# ===== YOUR CODE HERE =====
+#
+# Strategy in one paragraph: every decision is an expected-value comparison of
+# the legal actions.  Our equity comes from a vectorised Monte Carlo (numpy
+# lookup tables: 2 hole cards x 3 board cards -> hand rank), played against a
+# RANGE for the opponent: random hands re-weighted by everything the opponent
+# did this hand (raised -> top x%, called -> not the bottom y%, checked -> fewer
+# strong hands ...).  The x/y frequencies, the opponent's fold rate to each of
+# our bet sizes, his bet frequency when checked to and his bluff rate (read
+# from showdowns, per bet size) are all learned from his play in this half
+# with decaying counts on top of a "balanced" prior, so the same EV formula
+# value-bets thin vs calling stations, steals vs folders, traps and calls down
+# vs maniacs, and folds vs nits.  A separate detector spots an opponent whose
+# time bank ran out (check/fold autopilot) and raises every hand.
+
+import math
+import time
+from itertools import combinations, permutations
+
+import numpy as np
+
+from evaluator import get_table
+
+# ---------------------------------------------------------------------------
+# Fast evaluation tables (built once at startup, about 1-2 s)
+# ---------------------------------------------------------------------------
+NT = 7140  # C(36, 3)
+
+
+def _build_tables():
+    table = get_table()
+    binom = np.zeros((37, 6), dtype=np.int64)
+    for n_ in range(37):
+        for k_ in range(6):
+            binom[n_, k_] = math.comb(n_, k_)
+    c5 = np.array(list(combinations(range(36), 5)), dtype=np.int64)
+    masks = (np.int64(1) << c5).sum(1)
+    scores = np.fromiter((table[m] for m in masks.tolist()), dtype=np.int64, count=len(masks))
+    uniq, dense = np.unique(scores, return_inverse=True)
+    dcat = (uniq >> 20).astype(np.int64)
+    colex = binom[c5[:, 0], 1] + binom[c5[:, 1], 2] + binom[c5[:, 2], 3] + binom[c5[:, 3], 4] + binom[c5[:, 4], 5]
+    s5 = np.zeros(int(binom[36, 5]), dtype=np.uint16)
+    s5[colex] = dense.astype(np.uint16)
+    del c5, masks, scores, dense, colex
+    pairs = np.array(list(combinations(range(36), 2)), dtype=np.int8)
+    trips = np.array(list(combinations(range(36), 3)), dtype=np.int8)
+    allc = np.concatenate([np.broadcast_to(pairs[:, None, :], (630, NT, 2)),
+                           np.broadcast_to(trips[None, :, :], (630, NT, 3))], axis=2).reshape(-1, 5)
+    allc = np.sort(allc, axis=1).astype(np.int64)
+    dup = (np.diff(allc, axis=1) == 0).any(1)
+    cx = binom[allc[:, 0], 1] + binom[allc[:, 1], 2] + binom[allc[:, 2], 3] + binom[allc[:, 3], 4] + binom[allc[:, 4], 5]
+    cx[dup] = 0
+    pt = s5[cx].astype(np.int16)
+    pt[dup] = -1
+    del allc, dup, cx
+    p2 = np.zeros((36, 36), dtype=np.int32)
+    for i, (a, b) in enumerate(pairs.tolist()):
+        p2[a, b] = i
+        p2[b, a] = i
+    t3 = np.zeros((36, 36, 36), dtype=np.int32)
+    ar = np.arange(NT, dtype=np.int32)
+    tr = trips.astype(np.int64)
+    for perm in permutations(range(3)):
+        t3[tr[:, perm[0]], tr[:, perm[1]], tr[:, perm[2]]] = ar
+    return pt, p2 * NT, t3, dcat, binom
+
+
+PT, P2N, T3, DCAT, BINOM = _build_tables()   # PT[pair*NT + triple] -> dense hand rank (higher = better)
+HP = list(combinations(range(5), 2))
+HP0 = np.array([a for a, _ in HP])
+HP1 = np.array([b for _, b in HP])
+BT = list(combinations(range(5), 3))
+BT0 = np.array([a for a, _, _ in BT])
+BT1 = np.array([b for _, b, _ in BT])
+BT2 = np.array([c for _, _, c in BT])
+B4 = list(combinations(range(4), 3))
+
+# ---------------------------------------------------------------------------
+# Preflop strength heuristic (vectorised).  Linear fit to MC equity vs random.
+# ---------------------------------------------------------------------------
+PF_COEF = np.array([0.2645, 0.0563, 0.0285, 0.0643, 0.0029, -0.0074, 0.0008, -0.0197, -0.0668])
+
+
+def pf_features(cards):
+    """cards: (n,5) int array -> (n,9) feature matrix."""
+    c = np.sort(cards, axis=1)
+    r = c >> 2
+    s = c & 3
+    same = (r[:, 1:] == r[:, :-1])
+    npairs = same.sum(1)
+    sc = (s[:, :, None] == np.arange(4)).sum(1)
+    suited2 = (sc >= 2).sum(1)
+    suited3p = (sc >= 3).sum(1)
+    hi = r.sum(1) / 8.0
+    aces = (r == 8).sum(1)
+    # connectedness: distinct ranks pairwise gaps <= 2
+    rd = np.where(same, -10, r[:, 1:])
+    gaps = rd - r[:, :-1]
+    conn = ((gaps >= 1) & (gaps <= 2)).sum(1)
+    # suited ace
+    ace_suit = np.zeros(len(c), dtype=np.int64)
+    for k in range(5):
+        hit = (r[:, k] == 8)
+        ace_suit += hit & (sc[np.arange(len(c)), s[:, k]] >= 2)
+    trips = (same[:, 1:] & same[:, :-1]).sum(1)
+    return np.stack([np.ones(len(c)), np.minimum(npairs, 2) - 2 * trips, suited2, hi, conn,
+                     aces, ace_suit, suited3p, trips], axis=1).astype(np.float64)
+
+
+def _pf_table():
+    c5 = np.array(list(combinations(range(36), 5)), dtype=np.int64)
+    colex = BINOM[c5[:, 0], 1] + BINOM[c5[:, 1], 2] + BINOM[c5[:, 2], 3] + BINOM[c5[:, 3], 4] + BINOM[c5[:, 4], 5]
+    out = np.zeros(len(c5), dtype=np.float32)
+    out[colex] = (pf_features(c5) @ PF_COEF).astype(np.float32)
+    return out
+
+
+B1, B2, B3, B4_, B5 = (BINOM[:, k].copy() for k in range(1, 6))
+PF5 = _pf_table()
+
+
+def pf_strength(cards):
+    """Preflop strength of (n,5) hands via the precomputed table."""
+    c = np.sort(cards, axis=1)
+    return PF5[B1[c[:, 0]] + B2[c[:, 1]] + B3[c[:, 2]] + B4_[c[:, 3]] + B5[c[:, 4]]].astype(np.float64)
+
+
+# ---------------------------------------------------------------------------
+# Monte Carlo against a weighted range
+# ---------------------------------------------------------------------------
+
+def _pct(x):
+    n = len(x)
+    o = np.argsort(x, kind="stable")
+    p = np.empty(n)
+    p[o] = np.arange(n) / max(1, n - 1)
+    return p
+
+
+class MC:
+    """Samples n (opponent hand, runout) pairs and scores both hands."""
+
+    def __init__(self, hole, board, n, rng):
+        hole = np.asarray(hole, dtype=np.int64)
+        board = list(board)
+        dead = set(hole.tolist()) | set(board)
+        live = np.array([c for c in range(36) if c not in dead], dtype=np.int64)
+        nb = len(board)
+        k = 5 + (5 - nb)
+        r = rng.random((n, len(live)))
+        idx = np.argpartition(r, k - 1, axis=1)[:, :k]
+        o = np.argsort(np.take_along_axis(r, idx, axis=1), axis=1)
+        smp = live[np.take_along_axis(idx, o, axis=1)]
+        self.n = n
+        self.board = board
+        self.opp = smp[:, :5]
+        if nb < 5:
+            fb = np.concatenate([np.broadcast_to(np.array(board, dtype=np.int64), (n, nb)), smp[:, 5:]], axis=1)
+        else:
+            fb = np.broadcast_to(np.array(board, dtype=np.int64), (n, 5))
+        myp = P2N[hole[HP0], hole[HP1]]                           # (10,)
+        self.op = P2N[self.opp[:, HP0], self.opp[:, HP1]]         # (n,10)
+        if nb < 5:
+            tri = T3[fb[:, BT0], fb[:, BT1], fb[:, BT2]]            # (n,10)
+            self.my = PT[myp[None, :, None] + tri[:, None, :]].max(axis=(1, 2))
+            self.os = PT[self.op[:, :, None] + tri[:, None, :]].max(axis=(1, 2))
+        else:
+            b = board
+            tri = np.array([T3[b[i], b[j], b[k]] for i, j, k in BT], dtype=np.int32)
+            self.my = np.full(n, PT[myp[:, None] + tri[None, :]].max())
+            self.os = PT[self.op[:, :, None] + tri[None, None, :]].max(axis=(1, 2))
+        self.win = (self.my > self.os) + 0.5 * (self.my == self.os)
+        self._str = {}
+        self._ord = {}
+
+    def order(self, street):
+        """Sample indices sorted from strongest to weakest at a street."""
+        o = self._ord.get(street)
+        if o is None:
+            o = np.argsort(-self.strength(street), kind="stable")
+            self._ord[street] = o
+        return o
+
+    def strength(self, street):
+        """Opponent strength proxy at a street (higher = stronger)."""
+        if street in self._str:
+            return self._str[street]
+        if street == 0:
+            v = pf_strength(self.opp)
+        elif street == 3:
+            v = self.os.astype(np.float64)
+        else:
+            b = self.board
+            if street == 1:
+                t = np.array([T3[b[0], b[1], b[2]]])
+            else:
+                t = np.array([T3[b[i], b[j], b[k]] for i, j, k in B4])
+            cur = PT[self.op[:, :, None] + t[None, None, :]].max(axis=(1, 2))
+            v = _pct(cur) + 0.35 * _pct(self.os)
+        self._str[street] = v
+        return v
+
+
+def top_mask(order, w, frac):
+    """Boolean mask of the strongest `frac` (by weight) of the range.
+    `order` lists sample indices from strongest to weakest."""
+    n = len(order)
+    m = np.zeros(n, dtype=bool)
+    if frac <= 0:
+        return m
+    if frac >= 1:
+        m[:] = True
+        return m
+    cw = np.cumsum(w[order])
+    tot = cw[-1]
+    if tot <= 0:
+        m[:] = True
+        return m
+    k = int(np.searchsorted(cw, frac * tot, side="left"))
+    m[order[:k + 1]] = True
+    return m
+
+
+def bet_mult(s, w, f, b):
+    """Per-hand probability that the opponent takes an aggressive action that he
+    takes with overall frequency f, a fraction b of which are bluffs."""
+    f = min(max(f, 0.01), 1.0)
+    b = min(max(b, 0.0), 0.95)
+    val = f * (1 - b)
+    m = top_mask(s, w, val)   # s is an order array
+    rest = 1.0 - val
+    wb = min(1.0, f * b / rest) if rest > 1e-9 else 1.0
+    return np.where(m, 1.0, wb)
+
+
+def call_mult(s, w, f_fold, f_raise):
+    """Per-hand weight of a passive continue (call): bottom f_fold folded,
+    top f_raise would mostly have raised."""
+    bot = top_mask(s[::-1], w, f_fold) if f_fold > 0.02 else np.zeros(len(s), dtype=bool)
+    top = top_mask(s, w, f_raise * 0.7) if f_raise > 0.02 else np.zeros(len(s), dtype=bool)
+    out = np.ones(len(s))
+    out[bot] = 0.08
+    out[top & ~bot] = 0.5
+    return out
+
+
+def check_mult(s, w, f_bet, b):
+    """Opponent checked: hands he would have bet are less likely (traps remain)."""
+    m = bet_mult(s, w, f_bet, b)
+    return 1.0 - 0.7 * m
+
+
+# ---------------------------------------------------------------------------
+# Opponent statistics (decaying counts on top of balanced priors)
+# ---------------------------------------------------------------------------
+DECAY = 0.98
+PRIORS = {
+    "pf_open": [0.15, 0.45, 0.40],        # opp button first action: fold, call, raise
+    "pf_vs_raise": [0.30, 0.55, 0.15],    # opp facing our preflop raise
+    "pf_bb_vs_limp": [0.65, 0.35],        # opp BB after our limp: check, raise
+}
+for _s in (1, 2, 3):
+    PRIORS[f"s{_s}_first"] = [0.55, 0.25, 0.20]          # check, bet half, bet pot
+    PRIORS[f"s{_s}_vs_half"] = [0.40, 0.47, 0.13]        # fold, call, raise vs our half bet
+    PRIORS[f"s{_s}_vs_pot"] = [0.45, 0.43, 0.12]         # ... vs our pot bet
+    PRIORS[f"s{_s}_vs_raise"] = [0.35, 0.50, 0.15]       # ... vs our raise over his bet
+PRIORS["sd_half"] = [0.20, 0.80]   # opp half-pot aggression shown down: weak, strong
+PRIORS["sd_pot"] = [0.20, 0.80]
+PRIORS["sd_pf"] = [0.25, 0.75]
+PRIOR_W = {"sd_half": 3.0, "sd_pot": 3.0, "sd_pf": 3.0}
+DEFAULT_PRIOR_W = 4.0
+
+
+def _freq(mem, key):
+    c = mem["cnt"][key]
+    pr = PRIORS[key]
+    w = PRIOR_W.get(key, DEFAULT_PRIOR_W)
+    tot = sum(c) + w
+    return [(pr[i] * w + c[i]) / tot for i in range(len(c))]
+
+
+def _obs_stat(mem, key, outcome):
+    c = mem["cnt"][key]
+    for i in range(len(c)):
+        c[i] *= DECAY
+    c[outcome] += 1.0
+    mem["nobs"][key] = mem["nobs"].get(key, 0) + 1
+
+
+def new_half(config: AgentConfig, memory: dict) -> None:
+    """Fresh opponent model for every half."""
+    memory["rng"] = np.random.default_rng(20261107)
+    memory["cnt"] = {k: [0.0] * len(v) for k, v in PRIORS.items()}
+    memory["nobs"] = {}
+    memory["t_used"] = 0.0
+    memory["n_dec"] = 0
+    memory["cur"] = None
+    memory["recent"] = []         # recent opponent decisions: 'F' fold, 'X' check, 'A' active
+    memory["timeout_mode"] = False
+    memory["label"] = "unknown"
+    memory["label_hist"] = {}
+    memory["hands_seen"] = 0
+    memory["num_hands"] = int(getattr(config, "num_hands", 1000) or 1000)
+    memory["bank"] = float(getattr(config, "time_bank_seconds", 8.0) or 8.0)
+    memory["speed"] = 1.0
+    memory["t_dec"] = 0.0
+    memory["t_cpu"] = 0.0
+    memory["cont"] = 1.0
+    memory["ref_used"] = 0.0
+    memory["n_exc"] = 0
+    memory["t_start"] = time.time()
+
+
+# ---------------------------------------------------------------------------
+# Hand history walking
+# ---------------------------------------------------------------------------
+
+def _walk(history, i_am_button):
+    """Yield (record, ctx) for every action, ctx describing the situation the
+    actor faced: street, facing (bool), prev_aggr_size of the bet faced
+    ('half' / 'pot' / None), first_pf (opp button first action), raises."""
+    bets = {True: 1 if i_am_button else 2, False: 2 if i_am_button else 1}  # keyed by is_me
+    street = 0
+    last_aggr = None   # (is_me, action) of last raise on this street
+    aggr = set()       # who has bet/raised on this street
+    nacts_street = 0
+    for rec in history:
+        s = int(rec.street)
+        if s != street:
+            street = s
+            bets = {True: 0, False: 0}
+            last_aggr = None
+            aggr = set()
+            nacts_street = 0
+        me = rec.is_me
+        facing = bets[not me] > bets[me]
+        ctx = {
+            "street": s,
+            "facing": facing,
+            "faced": last_aggr,
+            "first": nacts_street == 0,
+            "agg_by_actor_before": me in aggr,
+        }
+        yield rec, ctx
+        if rec.street_total >= 0:
+            bets[me] = rec.street_total
+        elif rec.action == Action.CHECK_CALL:
+            bets[me] = max(bets[me], bets[not me])
+        if rec.action in (Action.RAISE_HALF, Action.RAISE_POT):
+            last_aggr = (me, rec.action)
+            aggr.add(me)
+        nacts_street += 1
+
+
+def _opp_key(rec, ctx, opp_is_button):
+    """Stat key and outcome index for one opponent action."""
+    s = ctx["street"]
+    a = rec.action
+    if s == 0:
+        if ctx["first"] and opp_is_button:
+            return "pf_open", (0 if a == Action.FOLD else 1 if a == Action.CHECK_CALL else 2)
+        if ctx["facing"] and ctx["faced"] is not None:
+            return "pf_vs_raise", (0 if a == Action.FOLD else 1 if a == Action.CHECK_CALL else 2)
+        if not ctx["facing"] and not opp_is_button:
+            return "pf_bb_vs_limp", (0 if a == Action.CHECK_CALL else 1)
+        return None, None
+    if not ctx["facing"]:
+        return f"s{s}_first", (0 if a == Action.CHECK_CALL else 1 if a == Action.RAISE_HALF else 2)
+    faced = ctx["faced"]
+    if faced is None:
+        return None, None
+    if ctx["agg_by_actor_before"]:
+        key = f"s{s}_vs_raise"
+    else:
+        key = f"s{s}_vs_half" if faced[1] == Action.RAISE_HALF else f"s{s}_vs_pot"
+    return key, (0 if a == Action.FOLD else 1 if a == Action.CHECK_CALL else 2)
+
+
+def _range_weights(mc, history, i_am_button, mem):
+    """Re-weight the sampled opponent hands by his actions so far this hand."""
+    n = mc.n
+    w = np.ones(n)
+    opp_is_button = not i_am_button
+    for rec, ctx in _walk(history, i_am_button):
+        if rec.is_me:
+            continue
+        key, out = _opp_key(rec, ctx, opp_is_button)
+        if key is None:
+            continue
+        s = mc.order(ctx["street"])
+        fr = _freq(mem, key)
+        a = rec.action
+        st = ctx["street"]
+        if st == 0:
+            b = _freq(mem, "sd_pf")[0] * 0.6
+            if key == "pf_open":
+                if out == 2:
+                    m = bet_mult(s, w, fr[2], b)
+                else:
+                    m = call_mult(s, w, fr[0], fr[2])
+            elif key == "pf_vs_raise":
+                m = bet_mult(s, w, fr[2], b) if out == 2 else call_mult(s, w, fr[0], fr[2])
+            else:
+                m = bet_mult(s, w, fr[1], b) if out == 1 else check_mult(s, w, fr[1], b)
+        elif key.endswith("_first"):
+            fbet = fr[1] + fr[2]
+            if a == Action.CHECK_CALL:
+                m = check_mult(s, w, fbet, 0.3)
+            else:
+                b = _freq(mem, "sd_half" if a == Action.RAISE_HALF else "sd_pot")[0]
+                m = bet_mult(s, w, fbet, b)
+        else:
+            if a == Action.CHECK_CALL:
+                m = call_mult(s, w, fr[0], fr[2])
+            elif a in (Action.RAISE_HALF, Action.RAISE_POT):
+                b = _freq(mem, "sd_half" if a == Action.RAISE_HALF else "sd_pot")[0] * 0.7
+                m = bet_mult(s, w, fr[2] / max(0.05, 1 - fr[0]), b)
+            else:
+                continue
+        w2 = w * m
+        if w2.sum() < 0.04 * n:      # keep a minimum effective range
+            w2 = w * (0.5 + 0.5 * m)
+        w = w2
+    return w
+
+
+# ---------------------------------------------------------------------------
+# Decision
+# ---------------------------------------------------------------------------
+
+REF_DEC = 0.00045      # our mean compute per decision on the dev machine (s)
+OVH_LOCAL = 0.0006     # judge+HTTP+framework round trip per request on the dev machine (s)
+TARGET = 0.55          # aim to be charged at most this share of the bank per half
+
+
+def _samples(mem, street):
+    """Monte Carlo sample count that keeps the half's projected charge
+    (our compute + per-request overhead beyond the free 1 ms, both scaled by
+    the measured CPU speed) under TARGET of the time bank."""
+    if mem.get("no_throttle"):        # dev harness only (strategy evaluation)
+        return 240 if street == 0 else 200
+    used = mem["t_used"]
+    nd = mem["n_dec"]
+    hs = max(1, mem["hands_seen"])
+    speed = 1.0
+    cont = 1.0
+    if nd >= 30 and mem["ref_used"] > 0.004:
+        # CPU speed from CPU time; contention from wall/CPU (preemption by other processes)
+        speed = min(6.0, max(0.5, mem["t_cpu"] / mem["ref_used"]))
+        cont = min(4.0, max(1.0, mem["t_dec"] / max(1e-6, mem["t_cpu"])))
+    mem["speed"] = speed
+    mem["cont"] = cont
+    calls_per_hand = max(3.0, nd / hs) if mem["hands_seen"] >= 20 else 4.5
+    left_calls = max(1.0, (mem["num_hands"] - mem["hands_seen"]) * calls_per_hand)
+    ovh = max(0.0, OVH_LOCAL * speed * cont * cont * 1.15 - 0.001)
+    speed = speed * cont      # our compute is charged at wall-clock rate
+    projected = used + nd * ovh + left_calls * ovh
+    per_call = (TARGET * mem["bank"] - projected) / left_calls
+    # hard caps on our own compute, whatever the projection says
+    if used > 0.38 * mem["bank"]:
+        return 0
+    if used > 0.30 * mem["bank"]:
+        return -1
+    full = 240 if street == 0 else 200
+    # cost model (dev machine): ~0.27 ms fixed numpy/python overhead + 0.8 us per sample
+    if used <= 0.22 * mem["bank"] and per_call >= _cost(full) * speed:
+        return full
+    if per_call >= _cost(60) * speed:
+        return 60
+    if per_call >= 0.00016 * speed:
+        return -1          # lite mode
+    return 0
+
+
+def _cost(n):
+    return 0.00027 + 0.0000008 * n
+
+
+def _eq(win, w):
+    t = w.sum()
+    return float((win * w).sum() / t) if t > 1e-9 else 0.5
+
+
+def _fallback(obs):
+    """No-simulation rule bot used only if the time bank gets tight."""
+    legal = obs.legal_actions
+    if obs.street == 0:
+        st = float(pf_strength(np.array([obs.hole_cards]))[0])
+        if st > 0.56 and Action.RAISE_POT in legal:
+            return Action.RAISE_POT
+        if obs.to_call <= 2 * obs.big_blind or st > 0.5:
+            return Action.CHECK_CALL
+        return Action.FOLD if Action.FOLD in legal else Action.CHECK_CALL
+    if len(obs.board) == 5:
+        from evaluator import omaha_score
+        cat = omaha_score(obs.hole_cards, obs.board) >> 20
+    else:
+        hole = np.asarray(obs.hole_cards)
+        b = obs.board
+        ts = [T3[b[i], b[j], b[k]] for i, j, k in combinations(range(len(b)), 3)]
+        best = PT[P2N[hole[HP0], hole[HP1]][:, None] + np.array(ts)[None, :]].max()
+        cat = int(DCAT[best])
+    if cat >= 4 and Action.RAISE_POT in legal:
+        return Action.RAISE_POT
+    if obs.to_call == 0:
+        return Action.CHECK_CALL
+    if cat >= 2 and obs.to_call <= obs.pot * 0.6:
+        return Action.CHECK_CALL
+    return Action.FOLD if Action.FOLD in legal else Action.CHECK_CALL
+
+
+def _lite(obs, mem):
+    """Cheap mode for a tight time bank: 48-sample equity vs a random hand,
+    shaded by the opponent's aggression this hand, with the learned fold
+    rates in the same EV formulas."""
+    legal = obs.legal_actions
+    st = int(obs.street)
+    C, P = obs.to_call, obs.pot
+    rng = mem["rng"]
+    eq = float(MC(obs.hole_cards, obs.board, 48, rng).win.mean())
+    if st == 0:
+        agg = _freq(mem, "pf_open")[2]
+    else:
+        fr = _freq(mem, f"s{st}_first")
+        agg = fr[1] + fr[2]
+    shade = 0.0
+    for r in obs.action_history:
+        if not r.is_me and r.action in (Action.RAISE_HALF, Action.RAISE_POT):
+            shade += (0.40 if int(r.street) == st else 0.10) * (1.0 - min(1.0, agg))
+    eq = max(0.03, eq - shade)
+    rho = 1.0 if (st == 3 or obs.is_button) else 0.93
+    ev = {}
+    if C > 0:
+        ev[Action.FOLD] = 0.0
+        eff = min(C, obs.my_stack)
+        ev[Action.CHECK_CALL] = rho * eq * (P + 2 * eff - C) - eff
+    else:
+        ev[Action.CHECK_CALL] = rho * eq * P
+    for a in (Action.RAISE_HALF, Action.RAISE_POT):
+        if a not in legal:
+            continue
+        R = obs.raise_to[a]
+        add = R - obs.my_bet
+        need = R - obs.opp_bet
+        opp_call = min(need, obs.opp_stack)
+        cost = add - (need - opp_call)
+        if st == 0:
+            f = _freq(mem, "pf_vs_raise")[0]
+        else:
+            f = _freq(mem, f"s{st}_vs_half" if a == Action.RAISE_HALF else f"s{st}_vs_pot")[0]
+        f = min(max(f, 0.02), 0.95)
+        eqc = max(0.02, eq - 0.25 * f)       # the hands that continue are stronger
+        ev[a] = f * P + (1 - f) * (rho * eqc * (P + cost + opp_call) - cost)
+    return max(ev, key=ev.get)
+
+
+def _decide(obs, mem):
+    legal = obs.legal_actions
+    if len(legal) == 1:
+        return legal[0]
+    st = int(obs.street)
+    C = obs.to_call
+    P = obs.pot
+    raises = [a for a in (Action.RAISE_HALF, Action.RAISE_POT) if a in legal]
+
+    # Opponent on check/fold autopilot (time bank gone) or a pure folder: raise.
+    if mem["timeout_mode"] and raises:
+        mem["ref_used"] += 0.00001
+        return Action.RAISE_HALF if Action.RAISE_HALF in legal else raises[0]
+
+    n = _samples(mem, st)
+    if n == 0:
+        mem["ref_used"] += 0.00006
+        return _fallback(obs)
+    if n < 0:
+        mem["ref_used"] += 0.00016
+        return _lite(obs, mem)
+    mem["ref_used"] += _cost(n)
+    rng = mem["rng"]
+    cur = mem.get("cur") or {}
+    key = (obs.hand_index, st)
+    mc = cur.get("mc")
+    if mc is None or cur.get("mc_key") != key or mc.n < n:
+        mc = MC(obs.hole_cards, obs.board, n, rng)
+        cur["mc"] = mc
+        cur["mc_key"] = key
+    else:
+        mem["ref_used"] -= 0.00012 + n * 0.0000006   # reused samples are cheaper
+    me_btn = obs.is_button
+    w = _range_weights(mc, obs.action_history, me_btn, mem)
+    win = mc.win
+    s_cur = mc.order(st)
+    eqR = _eq(win, w)
+
+    # position / equity realisation
+    if st == 3:
+        rho = 1.0
+    elif st == 0:
+        rho = 0.98 if me_btn else 0.92
+    else:
+        rho = 1.0 if me_btn else 0.93
+
+    ev = {}
+    if C > 0:
+        ev[Action.FOLD] = 0.0
+        eff = min(C, obs.my_stack)
+        ev[Action.CHECK_CALL] = rho * eqR * (P + 2 * eff - C) - eff
+    else:
+        # does the opponent still act after a check?
+        opp_acts_after = (st > 0 and not me_btn and not any(
+            int(r.street) == st for r in obs.action_history))
+        if opp_acts_after:
+            fr = _freq(mem, f"s{st}_first")
+            fbet = fr[1] + fr[2]
+            b = 0.5 * (_freq(mem, "sd_half")[0] + _freq(mem, "sd_pot")[0])
+            mb = bet_mult(s_cur, w, fbet, b)
+            wb = w * mb
+            wk = w * (1 - mb)
+            pb = float(wb.sum() / max(1e-9, w.sum()))
+            bo = P * (0.5 * fr[1] + 1.0 * fr[2]) / max(1e-6, fr[1] + fr[2])
+            eqb = _eq(win, wb)
+            eqk = _eq(win, wk)
+            ev_face = max(0.0, rho * eqb * (P + 2 * bo) - bo)
+            ev[Action.CHECK_CALL] = (1 - pb) * rho * eqk * P + pb * ev_face
+        else:
+            ev[Action.CHECK_CALL] = rho * eqR * P
+
+    for a in raises:
+        R = obs.raise_to[a]
+        add = R - obs.my_bet
+        need = R - obs.opp_bet
+        opp_call = min(need, obs.opp_stack)
+        refund = need - opp_call
+        if st == 0:
+            f = _freq(mem, "pf_vs_raise")[0]
+        else:
+            opp_aggr_here = any(int(r.street) == st and not r.is_me and
+                                r.action in (Action.RAISE_HALF, Action.RAISE_POT)
+                                for r in obs.action_history)
+            if opp_aggr_here:
+                f = _freq(mem, f"s{st}_vs_raise")[0]
+            else:
+                f = _freq(mem, f"s{st}_vs_half" if a == Action.RAISE_HALF else f"s{st}_vs_pot")[0]
+        f = min(max(f, 0.02), 0.95)
+        mask = top_mask(s_cur, w, 1 - f)
+        eqc = _eq(win, w * mask)
+        cost = add - refund
+        ev[a] = f * P + (1 - f) * (rho * eqc * (P + cost + opp_call) - cost)
+
+    # small noise so we are not perfectly predictable at the margins
+    noise = rng.normal(0, 0.015 * max(P, 4), size=len(ev))
+    best = max(zip(ev.keys(), noise), key=lambda kv: ev[kv[0]] + kv[1])[0]
+    mem["last_ev"] = (round(eqR, 3), {k.name: round(v, 2) for k, v in ev.items()})
+    return best
+
+
+def choose_action(obs: Observation, memory: dict) -> Action:
+    """EV-maximising action against the modelled opponent range."""
+    t0 = time.perf_counter()
+    c0 = time.process_time()
+    legal = obs.legal_actions
+    try:
+        cur = memory.get("cur")
+        if cur is None or cur["idx"] != obs.hand_index:
+            cur = {"idx": obs.hand_index, "btn": obs.is_button, "hole": tuple(obs.hole_cards)}
+            memory["cur"] = cur
+        cur["hist"] = obs.action_history
+        cur["street"] = int(obs.street)
+        cur["to_call"] = obs.to_call
+        action = _decide(obs, memory)
+        if action not in legal:
+            action = Action.CHECK_CALL
+        cur["last"] = action
+        cur["last_total"] = obs.raise_to.get(action, obs.opp_bet) if action in (
+            Action.RAISE_HALF, Action.RAISE_POT) else max(obs.my_bet, obs.opp_bet)
+    except Exception:
+        memory["n_exc"] = memory.get("n_exc", 0) + 1
+        action = Action.CHECK_CALL if Action.CHECK_CALL in legal else legal[0]
+    dt = time.perf_counter() - t0
+    memory["t_used"] = memory.get("t_used", 0.0) + dt
+    memory["t_dec"] = memory.get("t_dec", 0.0) + dt
+    memory["t_cpu"] = memory.get("t_cpu", 0.0) + (time.process_time() - c0)
+    memory["n_dec"] = memory.get("n_dec", 0) + 1
+    return action
+
+
+# ---------------------------------------------------------------------------
+# Learning from finished hands
+# ---------------------------------------------------------------------------
+
+def _classify(mem):
+    """Label the opponent (for logs/report; the EV model itself is continuous)."""
+    po = _freq(mem, "pf_open")
+    agg = []
+    fold = []
+    for s in (1, 2, 3):
+        f = _freq(mem, f"s{s}_first")
+        agg.append(f[1] + f[2])
+        fold.append(0.5 * (_freq(mem, f"s{s}_vs_half")[0] + _freq(mem, f"s{s}_vs_pot")[0]))
+    a = sum(agg) / 3
+    fo = sum(fold) / 3
+    if mem["timeout_mode"]:
+        return "timed-out/check-folder"
+    if fo > 0.75 and a < 0.15:
+        return "check-folder"
+    if a > 0.65 or po[2] > 0.75:
+        return "maniac"
+    if fo < 0.2 and a < 0.3:
+        return "calling-station"
+    if fo > 0.55 or po[0] > 0.45:
+        return "nit"
+    return "balanced"
+
+
+def _showdown_update(mem, cur, result):
+    """Read the strength of the hands the opponent was aggressive with."""
+    opp = result.opp_hole
+    board = list(result.board)
+    if opp is None or len(board) != 5:
+        return
+    opp = np.asarray(opp, dtype=np.int64)
+    known = set(opp.tolist()) | set(board) | set(cur.get("hole", ()))
+    live = np.array([c for c in range(36) if c not in known], dtype=np.int64)
+    rng = mem["rng"]
+    seen_streets = set()
+    for rec, ctx in _walk(cur["hist_full"], cur["btn"]):
+        if rec.is_me or rec.action not in (Action.RAISE_HALF, Action.RAISE_POT):
+            continue
+        s = ctx["street"]
+        if s in seen_streets:
+            continue
+        seen_streets.add(s)
+        if s == 0:
+            rnd = live[np.argsort(rng.random((120, len(live))), axis=1)[:, :5]]
+            pr = pf_strength(np.vstack([opp[None, :], rnd]))
+            pct = float((pr[1:] < pr[0]).mean())
+            _obs_stat(mem, "sd_pf", 0 if pct < 0.5 else 1)
+            continue
+        nb = 3 if s == 1 else 4 if s == 2 else 5
+        b = board[:nb]
+        ts = np.array([T3[b[i], b[j], b[k]] for i, j, k in combinations(range(nb), 3)])
+        rnd = live[np.argsort(rng.random((120, len(live))), axis=1)[:, :5]]
+        allh = np.vstack([opp[None, :], rnd])
+        pp = P2N[allh[:, HP0], allh[:, HP1]]
+        sc = PT[pp[:, :, None] + ts[None, None, :]].max(axis=(1, 2))
+        pct = float((sc[1:] < sc[0]).mean() + 0.5 * (sc[1:] == sc[0]).mean())
+        key = "sd_half" if rec.action == Action.RAISE_HALF else "sd_pot"
+        _obs_stat(mem, key, 0 if pct < 0.5 else 1)
+
+
+def _update_timeout(mem, flags):
+    rec = mem["recent"]
+    rec.extend(flags)
+    if len(rec) > 40:
+        del rec[:len(rec) - 40]
+    last = rec[-14:]
+    mem["timeout_mode"] = (len(last) >= 10 and "A" not in last and last.count("F") >= 5)
+
+
+def on_hand_end(result: HandResult, memory: dict) -> None:
+    """Update the opponent model with everything this hand revealed."""
+    t0 = time.perf_counter()
+    try:
+        memory["hands_seen"] = memory.get("hands_seen", 0) + 1
+        cur = memory.get("cur")
+        flags = []
+        if cur is None or cur["idx"] != result.hand_index:
+            # We never acted: we were the big blind and the button folded.
+            _obs_stat(memory, "pf_open", 0)
+            flags.append("F")
+        else:
+            hist = list(cur["hist"])
+            last = cur.get("last")
+            st = cur.get("street", 0)
+            me_btn = cur["btn"]
+            tail = []
+            # our own last action (not in the history we saw)
+            if last is not None and last != Action.FOLD:
+                mt = cur.get("last_total", -1)
+                tail.append(_Rec(st, True, last, mt))
+                if last in (Action.RAISE_HALF, Action.RAISE_POT):
+                    if not result.went_to_showdown and result.winner == "me":
+                        tail.append(_Rec(st, False, Action.FOLD, -1))
+                    elif result.went_to_showdown:
+                        tail.append(_Rec(st, False, Action.CHECK_CALL, mt))
+                elif cur.get("to_call", 0) == 0 and st == 3 \
+                        and not me_btn and not any(int(r.street) == 3 for r in hist) \
+                        and result.went_to_showdown:
+                    tail.append(_Rec(st, False, Action.CHECK_CALL, mt))
+            full = hist + tail
+            cur["hist_full"] = full
+            opp_is_button = not me_btn
+            for rec, ctx in _walk(full, me_btn):
+                if rec.is_me:
+                    continue
+                key, out = _opp_key(rec, ctx, opp_is_button)
+                if key is not None:
+                    _obs_stat(memory, key, out)
+                if rec.action == Action.FOLD:
+                    flags.append("F")
+                elif rec.action == Action.CHECK_CALL and not ctx["facing"]:
+                    flags.append("X")
+                else:
+                    flags.append("A")
+            if result.went_to_showdown and result.opp_hole is not None:
+                _showdown_update(memory, cur, result)
+        _update_timeout(memory, flags)
+        lab = _classify(memory)
+        memory["label"] = lab
+        lh = memory["label_hist"]
+        lh[lab] = lh.get(lab, 0) + 1
+        if memory["hands_seen"] % 250 == 0:
+            import sys
+            print(f"[shark] hands {memory['hands_seen']} t_used {memory['t_used']:.2f}s "
+                  f"dec {memory['n_dec']} speed {memory.get('speed', 1):.2f} cont {memory.get('cont', 1):.2f} label {lab} "
+                  f"wall {time.time() - memory.setdefault('t_start', time.time()):.1f}s",
+                  file=sys.stderr, flush=True)
+    except Exception:
+        memory["n_exc"] = memory.get("n_exc", 0) + 1
+    memory["t_used"] = memory.get("t_used", 0.0) + (time.perf_counter() - t0)
+
+
+class _Rec:
+    """Minimal stand-in for ObservedAction (inferred actions)."""
+    __slots__ = ("street", "is_me", "action", "amount", "street_total")
+
+    def __init__(self, street, is_me, action, street_total=-1):
+        self.street = street
+        self.is_me = is_me
+        self.action = action
+        self.amount = 0
+        self.street_total = street_total
+
+# ===== END OF YOUR CODE =====
+
+
+# ===== SERVER PLUMBING (you normally don't need to edit below) =====
+# The judge calls these routes:
+#   GET  /           -> who you are (also used as the health check)
+#   POST /new-half   -> start a fresh half: memory is wiped
+#   POST /act        -> the judge sends any finished hands plus an Observation;
+#                       on_hand_end() runs for each hand, then you answer an action
+#   POST /hand-end   -> the judge sends the last finished hands of a half
+#
+# Why "async def"? The routes run on one thread and call your functions
+# directly, so your functions never run twice at once. Your own functions
+# stay normal "def" (don't make them async).
+#
+# Keep your per-half state in `memory`. In the tournament every half runs in
+# a fresh server process, so everything starts over. When you test locally,
+# though, one process can play both halves and only `memory` is wiped, NOT
+# other global variables. Using `memory` makes your bot behave the same way
+# in both places.
+
+app = FastAPI()
+MEMORY: dict = {}                                   # your memory for this half
+STATUS = {"started": False}                         # has /new-half been called?
+TOKEN = os.environ.get("AGENT_TOKEN") or None       # set by the tournament
+
+
+async def _read_request(request: Request, path: str) -> tuple[dict, JSONResponse | None]:
+    """Check the token (and that the half has started) BEFORE reading the body.
+
+    Checking first means a request without the right token costs your bot
+    almost nothing, so nobody else can slow it down by sending junk.
+    Returns (body, None) when the request is fine, or ({}, error response).
+    """
+    if TOKEN and request.headers.get("x-agent-token") != TOKEN:
+        return {}, JSONResponse({"error": "bad or missing X-Agent-Token"}, status_code=401)
+    if not STATUS["started"] and path != "/new-half":
+        return {}, JSONResponse({"error": "call /new-half first"}, status_code=409)
+    try:
+        body = await request.json()
+    except ValueError:
+        body = None
+    if not isinstance(body, dict):
+        return {}, JSONResponse({"error": "the request body must be a JSON object"}, status_code=400)
+    return body, None
+
+
+def _error_info(exc: Exception) -> dict:
+    """Describe an exception from your code (call this inside `except`)."""
+    return {"error": f"{type(exc).__name__}: {exc}", "traceback": traceback.format_exc()}
+
+
+def _crash(exc: Exception, hand_end_errors: list | None = None) -> JSONResponse:
+    """Report an exception from your code to the judge (with traceback)."""
+    return JSONResponse({**_error_info(exc), "hand_end_errors": hand_end_errors or []},
+                        status_code=500)
+
+
+def _deliver_results(raw_results) -> list:
+    """Call on_hand_end() for each finished hand the judge sent.
+    Returns a list of error reports (one per hand that crashed)."""
+    errors = []
+    for raw in raw_results or []:
+        try:
+            on_hand_end(HandResult.from_dict(raw), MEMORY)
+        except Exception as exc:
+            errors.append(_error_info(exc))
+    return errors
+
+
+@app.get("/")
+async def info():
+    """Health check: tells the judge who this bot is."""
+    return {"participant": PARTICIPANT, "agent_name": AGENT_NAME}
+
+
+@app.post("/new-half")
+async def route_new_half(request: Request):
+    """Wipe memory and call your new_half(). The body is {"config": {...}}."""
+    body, refused = await _read_request(request, "/new-half")
+    if refused:
+        return refused
+    MEMORY.clear()
+    STATUS["started"] = True
+    try:
+        new_half(AgentConfig.from_dict(body.get("config", {})), MEMORY)
+    except Exception as exc:
+        return _crash(exc)
+    return {"ok": True}
+
+
+@app.post("/act")
+async def route_act(request: Request):
+    """Deliver finished hands, then turn the JSON into an Observation, call
+    choose_action(), and send the answer back."""
+    body, refused = await _read_request(request, "/act")
+    if refused:
+        return refused
+    hand_end_errors = _deliver_results(body.get("hand_results"))
+    try:
+        obs = Observation.from_dict(body["observation"])
+        action = choose_action(obs, MEMORY)
+    except Exception as exc:
+        return _crash(exc, hand_end_errors)
+    # Send the action's name; anything strange is passed on for the judge to reject.
+    if isinstance(action, Action):
+        answer = action.name
+    elif action is None or isinstance(action, (str, int, float, bool)):
+        answer = action
+    else:
+        answer = repr(action)
+    return {"action": answer, "hand_end_errors": hand_end_errors}
+
+
+@app.post("/hand-end")
+async def route_hand_end(request: Request):
+    """Call on_hand_end() for the last finished hands of a half."""
+    body, refused = await _read_request(request, "/hand-end")
+    if refused:
+        return refused
+    return {"ok": True, "hand_end_errors": _deliver_results(body.get("results"))}
+
+
+if __name__ == "__main__":
+    # The tournament sets PORT as an environment variable, so each bot is compliant to our evaluation platform
+    # Locally it defaults to 5008 for your own testing convenience
+    port = int(os.environ.get("PORT", "5008"))
+    uvicorn.run(app, host="0.0.0.0", port=port, log_level="info", access_log=False)
+

index 0000000..364afec
--- /dev/null
+++ b/bot/exploit.py
@@ -0,0 +1,147 @@
+"""Exploit layer: reversible, evidence-gated modifiers of the base action (Task 14).
+
+apply_exploits(base, obs, feats, opp, rng) runs last in PolicyBot's chain: the base comes
+from the blueprint or the heuristic, and this layer may change it. opp is the half's
+OpponentModel (bot/opponent.py). At most one mode applies, chosen by detector precedence
+check-folder > maniac > station: station and maniac both fire on never-fold,
+always-raise bots.
+
+- check-folder (I2): RAISE_HALF whenever it is legal, else the base. Against a bot
+  whose bank ran out, every bet takes the pot.
+- maniac: the heuristic re-run with the call threshold MANIAC_CALL_SHIFT lower:
+  call_margin and the assumed bet range drop by it, and the weight of the range model
+  drops to MANIAC_RANGE_WEIGHT. Facing a bet those two dominate call_margin (Task 10).
+  Bluffs are off.
+- station: the heuristic re-run with value_raise and thin_value STATION_VALUE_SHIFT
+  lower (thinner value: v1's unopened bets come from thin_value) and bluffs off.
+- I6 (any mode): on the river, facing at least a BIG_BET_FRACTION-pot bet, fold
+  instead of calling when the weakest category the opponent showed down after betting
+  or raising the river (>= SHOWDOWN_MIN_N showdowns) is at least I6_CATEGORY_MARGIN
+  above our made category. Never with the nuts. River only: on earlier streets its
+  showdown hand is the river's, and it is seen only when the hand got there.
+  The plan's literal rule is "shown >= ours" (margin 0). On TRAIN every margin-0 fold
+  was a same-category spot, where kickers decide; calling would have won 6 of 11, at
+  25-33% pot odds. Margin 1 folds only hands below every category it has shown.
+
+Safety against adaptive bots: every mode reads the detectors' current evidence on every
+call, so it stops as soon as the evidence does (the detectors read recent windows). No
+mode adds a link between bet size and hand strength: check-folder bets one size with
+every hand, and the re-run modes keep the heuristic's own sizing rule. The re-run modes
+never fold a hand the base plays on, and no mode draws from rng: a decision the layer
+leaves alone is exactly v1's, and so is the rest of the Monte Carlo stream. The re-run
+modes need Features, so with a blueprint base (feats None) only check-folder and I6
+apply.
+
+Module state is read-only. stats (optional) is a dict of STAT_KEYS counters.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+
+from bot import equity
+from bot.heuristic import HeuristicParams, heuristic_action
+from evaluator import omaha_score
+from game import Action, Street
+
+STATION_VALUE_SHIFT = 0.08       # station: value_raise and thin_value lowered by this
+MANIAC_CALL_SHIFT = 0.06         # maniac: call_margin and bet_range lowered by this
+MANIAC_RANGE_WEIGHT = 0.5        # maniac: range_weight capped here (+1.3/+1.4 bb, Task 10)
+BIG_BET_FRACTION = 0.4           # I6: to_call / pot before the bet; a half-pot bet is 0.5
+I6_CATEGORY_MARGIN = 1           # I6: fold when its weakest shown category >= ours + this
+_CATEGORY_SHIFT = 20             # omaha_score's category bits
+
+STAT_KEYS = ("decisions", "check_folder", "maniac", "station", "check_folder_changed",
+             "maniac_changed", "station_changed", "i6")
+
+_FOLD, _CALL, _HALF = Action.FOLD, Action.CHECK_CALL, Action.RAISE_HALF
+
+
+def station_params(p: HeuristicParams) -> HeuristicParams:
+    """Station mode: thinner value bets and raises, no bluffs."""
+    return dataclasses.replace(
+        p, value_raise=tuple(v - STATION_VALUE_SHIFT for v in p.value_raise),
+        thin_value=tuple(v - STATION_VALUE_SHIFT for v in p.thin_value), bluff_freq=0.0)
+
+
+def maniac_params(p: HeuristicParams) -> HeuristicParams:
+    """Maniac mode: call wider (a lower call threshold and a wider assumed bet range,
+    weighted less), no bluffs."""
+    return dataclasses.replace(
+        p, call_margin=p.call_margin - MANIAC_CALL_SHIFT,
+        bet_range=tuple(t - MANIAC_CALL_SHIFT for t in p.bet_range),
+        range_weight=min(p.range_weight, MANIAC_RANGE_WEIGHT), bluff_freq=0.0)
+
+
+_SHIFTED = {"maniac": maniac_params, "station": station_params}
+
+
+class _NoDraw:
+    """The rng of a re-run with bluff_freq 0: the bluff draw cannot change the answer,
+    so the caller's generator is left untouched."""
+
+    __slots__ = ()
+
+    @staticmethod
+    def random() -> float:
+        return 1.0
+
+
+_NO_DRAW = _NoDraw()
+
+
+def active_mode(opp) -> str | None:
+    """The mode opp's current evidence calls for, by precedence; None for none."""
+    if opp is None:
+        return None
+    if opp.is_check_folder():
+        return "check_folder"
+    if opp.is_maniac():
+        return "maniac"
+    if opp.is_station():
+        return "station"
+    return None
+
+
+def _beaten_river_call(obs, feats, opp) -> bool:
+    """I6: calling this river bet loses to every hand the opponent has shown for it."""
+    if obs.street != Street.RIVER or obs.to_call <= 0 or _FOLD not in obs.legal_actions:
+        return False
+    before = obs.pot - obs.to_call
+    if before <= 0 or obs.to_call / before < BIG_BET_FRACTION:
+        return False
+    shown = opp.showdown_min_category(opp.current_class(obs))
+    if shown is None:
+        return False
+    nut = feats.nut if feats is not None else equity.nut_flags(obs.hole_cards, obs.board)
+    if nut & 1:
+        return False
+    ours = omaha_score(obs.hole_cards, obs.board) >> _CATEGORY_SHIFT
+    return shown >= ours + I6_CATEGORY_MARGIN
+
+
+def apply_exploits(base: Action, obs, feats, opp, rng, params: HeuristicParams | None = None,
+                   stats: dict | None = None) -> Action:
+    """The base action, modified by the mode the opponent model's evidence supports (see
+    the module docstring). params are the heuristic's (default HeuristicParams()). Returns
+    an Action; PolicyBot keeps the base if it is not legal."""
+    if opp is None:
+        return base
+    mode = active_mode(opp)
+    action = base
+    if mode == "check_folder":
+        if _HALF in obs.legal_actions:
+            action = _HALF
+    elif mode is not None and feats is not None:
+        p = params if params is not None else HeuristicParams()
+        alt = heuristic_action(obs, feats, _SHIFTED[mode](p), _NO_DRAW)
+        if not (alt == _FOLD and base != _FOLD):     # loosen or re-size, never fold more
+            action = alt
+    i6 = action == _CALL and _beaten_river_call(obs, feats, opp)
+    if stats is not None:
+        stats["decisions"] += 1
+        if mode is not None:
+            stats[mode] += 1
+            stats[mode + "_changed"] += action != base
+        stats["i6"] += i6
+    return _FOLD if i6 else action

+def test_i6_folds_a_river_call_the_opponent_always_beat():
+    rng = np.random.default_rng(0)
+    for obs, feats, base, ours in _river_calls():
+        for shown in {ours + 1, 8}:             # everything it showed is a higher category
+            opp = StubOpp(shown={(int(Street.RIVER), True): shown})
+            assert apply_exploits(base, obs, feats, opp, rng) == FOLD
+        for shown in {ours, max(ours - 1, 0)}:  # the same category or worse: keep calling
+            opp = StubOpp(shown={(int(Street.RIVER), True): shown})
+            assert apply_exploits(base, obs, feats, opp, rng) == base
+        assert apply_exploits(base, obs, feats, StubOpp(), rng) == base   # n < 5 shown
+        stats = dict.fromkeys(exploit.STAT_KEYS, 0)
+        apply_exploits(base, obs, feats, StubOpp(shown={(3, True): 8}), rng, stats=stats)
+        assert stats["i6"] == 1 and stats["decisions"] == 1

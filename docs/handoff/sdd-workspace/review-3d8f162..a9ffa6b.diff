+# ------------------------------------------------------------------- station
+
+def test_station_mode_bets_thinner_and_never_bluffs():
+    opp = StubOpp(station=True)
+    rng = np.random.default_rng(0)
+    thinner = bluffs_cut = 0
+    for (obs, feats, base), (_, _, bluffy) in zip(SPOTS, BLUFFY_SPOTS):
+        a = apply_exploits(bluffy, obs, feats, opp, rng, params=BLUFFY)
+        assert a in obs.legal_actions
+        if feats.street == Street.PREFLOP:
+            assert a == bluffy                      # preflop play is unchanged
+        elif obs.to_call == 0:
+            if _can_raise(obs):
+                eff = _unopened_eff(feats, BLUFFY)
+                # A bet only for value, and down to 0.08 thinner than the base's bar.
+                assert (a in RAISES) == (eff > _value_bar(feats, BLUFFY, STATION_VALUE_SHIFT))
+                thinner += a in RAISES and eff <= _value_bar(feats, BLUFFY)
+                bluffs_cut += bluffy in RAISES and a == CALL
+        else:
+            assert (a == FOLD) == (bluffy == FOLD)  # the call threshold is unchanged
+            if bluffy in RAISES:
+                assert a in RAISES                  # raises for value at least as often
+    assert thinner > 0 and bluffs_cut > 0
+
+
+# -------------------------------------------------------------------- maniac
+
+def test_maniac_mode_calls_wider_and_never_bluffs():
+    opp = StubOpp(maniac=True)
+    rng = np.random.default_rng(0)
+    wider = 0
+    for (obs, feats, base), (_, _, bluffy) in zip(SPOTS, BLUFFY_SPOTS):
+        a = apply_exploits(bluffy, obs, feats, opp, rng, params=BLUFFY)
+        assert a in obs.legal_actions
+        if obs.to_call > 0:
+            assert not (a == FOLD and bluffy != FOLD)   # never folds what the base plays
+            wider += bluffy == FOLD and a != FOLD
+        elif feats.street != Street.PREFLOP and _can_raise(obs):
+            eff = _unopened_eff(feats, BLUFFY)
+            assert (a in RAISES) == (eff > _value_bar(feats, BLUFFY))   # value only
+        else:
+            assert a == bluffy
+    assert wider > 10
+

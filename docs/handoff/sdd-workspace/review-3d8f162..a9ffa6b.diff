+def test_maniac_mode_is_the_heuristic_with_lower_call_thresholds():
+    # The mode re-runs the heuristic with the call threshold (call_margin and the
+    # assumed bet range) MANIAC_CALL_SHIFT lower and the range weight cut.
+    m = exploit.maniac_params(P)
+    assert m.call_margin == pytest.approx(P.call_margin - MANIAC_CALL_SHIFT)
+    assert m.bet_range == pytest.approx(tuple(t - MANIAC_CALL_SHIFT for t in P.bet_range))
+    assert m.range_weight <= exploit.MANIAC_RANGE_WEIGHT and m.bluff_freq == 0.0
+    assert (m.value_raise, m.thin_value) == (P.value_raise, P.thin_value)
+    s = exploit.station_params(P)
+    assert s.value_raise == pytest.approx(tuple(v - STATION_VALUE_SHIFT for v in P.value_raise))
+    assert s.thin_value == pytest.approx(tuple(v - STATION_VALUE_SHIFT for v in P.thin_value))
+    assert s.bluff_freq == 0.0 and s.call_margin == P.call_margin
+

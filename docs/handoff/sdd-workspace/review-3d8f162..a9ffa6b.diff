+# ------------------------------------------------------------------------ I6
+
+def _ours(obs):
+    return omaha_score(obs.hole_cards, obs.board) >> 20
+
+
+def _river_calls():
+    """River spots facing at least a half-pot bet where the base calls, without the nuts,
+    below a straight flush (so a stronger category exists)."""
+    out = []
+    for obs, feats, base in SPOTS:
+        if (obs.street == Street.RIVER and obs.to_call > 0 and base == CALL
+                and not feats.nut & 1 and feats.facing_frac >= 0.45 and _ours(obs) < 8):
+            out.append((obs, feats, base, _ours(obs)))
+    assert len(out) >= 5
+    return out

+def test_i6_needs_the_river_a_big_bet_and_no_nuts():
+    rng = np.random.default_rng(0)
+    every = StubOpp(shown={(s, a): 8 for s in range(4) for a in (False, True)})
+    nuts = small = early = 0
+    for obs, feats, base in SPOTS:
+        if obs.to_call <= 0 or base != CALL:
+            continue
+        a = apply_exploits(base, obs, feats, every, rng)
+        if obs.street != Street.RIVER:
+            assert a == base                    # flop/turn categories are not final yet
+            early += 1
+        elif feats.nut & 1:
+            assert a == base                    # never fold the nuts
+            nuts += 1
+        elif feats.facing_frac < exploit.BIG_BET_FRACTION:
+            assert a == base                    # a small bet keeps its price
+            small += 1
+        else:
+            assert a == (FOLD if _ours(obs) < 8 else base)
+    assert early > 10
+    # Make the missing cases from real river calls: the nuts, and a small bet.
+    obs, feats, base, ours = _river_calls()[0]
+    assert apply_exploits(base, obs, None, every, rng) == FOLD     # no Features: same rule
+    nut_feats = dataclasses.replace(feats, nut=feats.nut | 1)
+    assert apply_exploits(base, obs, nut_feats, every, rng) == base
+    cheap = dataclasses.replace(obs, to_call=1)
+    cheap_feats = dataclasses.replace(feats, facing_frac=0.1)
+    assert apply_exploits(base, cheap, cheap_feats, every, rng) == base

+"""Task 14: the exploit layer (bot/exploit.py) and PolicyBot's opponent-model wiring.
+
+Unit tests drive apply_exploits with a stub opponent (fixed detector answers) on
+observations from real engine hands. The sim tests compare v2 = PolicyBot() with
+v1 = PolicyBot(use_exploits=False) on common seeds with paired_diff.
+"""
+
+import dataclasses
+import functools
+import random
+
+import numpy as np
+import pytest
+
+from bot import exploit, policy
+from bot.exploit import MANIAC_CALL_SHIFT, STATION_VALUE_SHIFT, apply_exploits
+from bot.features import compute_features
+from bot.heuristic import HeuristicParams, heuristic_action
+from bot.opponent import SHOWDOWN_MIN_N, OpponentModel
+from evaluator import omaha_score
+from game import Action, AgentConfig, Game, Street, make_deal
+from sim.match import play_half
+from sim.opponents import HOLDOUT, ZOO
+from sim.opponents.archetypes import checkfold_after
+from sim.tournament import paired_diff
+
+policy.warmup()                 # our tables, and omaha_score's (the I6 rule scores hands)
+
+P = HeuristicParams()
+BLUFFY = HeuristicParams(bluff_freq=1.0)      # the base bluffs whenever it may
+RAISES = (Action.RAISE_HALF, Action.RAISE_POT)
+FOLD, CALL, HALF = Action.FOLD, Action.CHECK_CALL, Action.RAISE_HALF
+V2 = policy.PolicyBot
+V1 = functools.partial(policy.PolicyBot, use_exploits=False)
+WORKERS = 2                     # R32: sims share CPUs 0-7 with Task 12's tuner
+
+
+class StubOpp:
+    """The detector interface apply_exploits reads, with fixed answers."""
+
+    def __init__(self, check_folder=False, maniac=False, station=False, shown=None):
+        self.flags = (check_folder, maniac, station)
+        self.shown = dict(shown or {})          # (street, aggressive) -> weakest category
+
+    def is_check_folder(self):
+        return self.flags[0]
+
+    def is_maniac(self):
+        return self.flags[1]
+
+    def is_station(self):
+        return self.flags[2]
+
+    def showdown_min_category(self, action_class, min_n=SHOWDOWN_MIN_N):
+        return self.shown.get(tuple(action_class))
+
+    current_class = staticmethod(OpponentModel.current_class)
+
+
+def _spots(seed="exp", hands=200, params=P):
+    """(obs, feats, base) at every decision of real hands, both seats, with a raise-happy
+    random mix of actions: all streets, facing bets, the raise cap and all-ins show up.
+    feats use no Monte Carlo (deterministic); base is the heuristic's answer."""
+    pick = random.Random(seed)
+    rng = np.random.default_rng(11)
+    out = []
+    for h in range(hands):
+        g = Game(make_deal(seed, h), h % 2, hand_index=h)
+        while not g.is_terminal:
+            obs = g.observation(g.to_act)
+            feats = compute_features(obs, 0, rng)
+            out.append((obs, feats, heuristic_action(obs, feats, params, rng)))
+            legal = obs.legal_actions
+            u = pick.random()
+            raises = [a for a in legal if a in RAISES]
+            if raises and u < 0.35:
+                g.apply(pick.choice(raises))
+            elif FOLD in legal and u > 0.95:
+                g.apply(FOLD)
+            else:
+                g.apply(CALL)
+    return out
+
+
+SPOTS = _spots()
+BLUFFY_SPOTS = _spots(params=BLUFFY)
+
+
+def _unopened_eff(f, p):
+    """The heuristic's effective equity when nothing is owed postflop."""
+    nonnut = bool(f.nut & 0b110) and not (f.nut & 1)
+    if f.street == Street.RIVER and f.nut & 1:
+        return 1.0
+    return f.eq - (p.nonnut_penalty if nonnut else 0.0)
+
+
+def _value_bar(f, p, shift=0.0):
+    """Unopened postflop: the heuristic bets for value above this effective equity."""
+    i = int(f.street) - 1
+    thin = p.thin_value[i] - (p.ip_thin_shift if f.in_position else 0.0)
+    return min(p.value_raise[i], thin) - shift
+
+
+def _can_raise(obs):
+    return any(a in obs.legal_actions for a in RAISES)
+
+
+# ------------------------------------------------------------------ check-folder (I2)
+
+def test_checkfolder_mode_only_returns_legal_raises_or_base():
+    opp = StubOpp(check_folder=True)
+    rng = np.random.default_rng(0)
+    raised = kept = 0
+    for obs, feats, base in SPOTS:
+        a = apply_exploits(base, obs, feats, opp, rng)
+        assert a in obs.legal_actions
+        if HALF in obs.legal_actions:
+            assert a == HALF
+            raised += 1
+        else:
+            assert a == base
+            kept += 1
+    assert raised > 100 and kept > 20               # both branches really ran
+
+
+class _Keep:
+    """PolicyBot in a sim half, keeping each half's memory and every decision."""
+
+    def __init__(self, memories, log, **kw):
+        self.bot = policy.PolicyBot(**kw)
+        self.memories, self.log = memories, log
+
+    def new_half(self, config, memory):
+        self.bot.new_half(config, memory)
+        self.memories.append(memory)
+
+    def choose_action(self, obs, memory):
+        a = self.bot.choose_action(obs, memory)
+        self.log.append((obs, a, memory["opp"].is_check_folder()))
+        return a
+
+    def on_hand_end(self, result, memory):
+        self.bot.on_hand_end(result, memory)
+
+
+class _FoldThenFight:
+    """Check/fold for the first `n` hands, then bet or raise whenever it can: a bait for
+    the check-folder mode."""
+
+    def __init__(self, n=100):
+        self.n = n
+
+    def new_half(self, config, memory):
+        pass
+
+    def choose_action(self, obs, memory):
+        if obs.hand_index < self.n:
+            return CALL if obs.to_call == 0 else FOLD
+        return Action.RAISE_POT if Action.RAISE_POT in obs.legal_actions else CALL
+
+    def on_hand_end(self, result, memory):
+        pass
+
+
+def test_checkfolder_mode_stops_when_the_opponent_fights_back():
+    memories, log = [], []
+    h = play_half(lambda: _Keep(memories, log), _FoldThenFight, "bait", 1, deals=200)
+    assert h.errors_a == 0
+    first = min(obs.hand_index for obs, a, flag in log if flag)
+    assert first < 60                                   # found while it check-folds
+    seen = next(i for i, (obs, a, flag) in enumerate(log) if obs.hand_index >= 100
+                and any(not r.is_me and r.action in RAISES for r in obs.action_history))
+    assert log[seen - 1][2]                             # on until its first raise shows
+    assert not any(flag for obs, a, flag in log[seen:])  # and off from then on
+    (memory,) = memories
+    assert memory["exploits"]["maniac"] > 0             # then it is read as what it is
+
+
+def test_checkfolder_mode_bets_every_legal_spot_in_a_real_half():
+    # checkfold_after(0) is a bot whose bank ran out before the half began.
+    memories, log = [], []
+    h = play_half(lambda: _Keep(memories, log), checkfold_after(0), "cf0", 1, deals=120)
+    assert h.errors_a == 0 and not h.forfeit_a
+    on = [(obs, a) for obs, a, flag in log if flag]
+    assert len(on) > 50
+    assert all(a == HALF for obs, a in on if HALF in obs.legal_actions)
+    (memory,) = memories
+    assert memory["exploits"]["check_folder"] == len(on)
+    assert sum(h.nets_a[60:]) > 0.5 * 60 * 2        # it wins the blinds nearly every hand
+

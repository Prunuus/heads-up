+    folds, so a raise shows the bot's own strategy at work."""
+    assert h.errors_a == 0 and not h.forfeit_a
+    assert swallowed == []
+    assert h.actions_a.get("RAISE_HALF", 0) + h.actions_a.get("RAISE_POT", 0) > 0
+

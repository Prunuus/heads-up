+    for obs in _observations("bp-cfg", 15):
+        assert bot.choose_action(obs, memory) in obs.legal_actions
+    assert fake.calls == [] and memory["layers"]["blueprint"] == 0
+    assert sum(memory["faults"].values()) == 0

+def test_with_hole_is_dataclasses_replace():
+    obs = Game(make_deal("wh", 0), 0).observation(0)
+    hole = (0, 1, 2, 3, 4)
+    assert lbr._with_hole(obs, hole) == dataclasses.replace(obs, hole_cards=hole)
+    assert obs.hole_cards != hole
